        }
      }
    },
    "32": {
      "type": "data",
      "title": "Storage Utilization (%)",
      "queryConfig": {
        "metricSelector": "(custom.proxmox.storage.used:filter(eq(cluster_name,$cluster_name)):splitBy(storage_name,node_name) / custom.proxmox.storage.total:filter(eq(cluster_name,$cluster_name)):splitBy(storage_name,node_name)) * 100",
        "visualization": {
          "type": "barChart"
        }
      }
    }
  },

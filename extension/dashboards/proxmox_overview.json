{
  "version": 15,
  "defaultTimeframe": {
    "from": "now-1h",
    "to": "now"
  },
  "variables": [
    {
      "key": "cluster_name",
      "displayName": "Cluster",
      "type": "QUERY",
      "definition": {
        "seriesResolution": "AUTO",
        "queryDefinition": {
          "type": "METRIC",
          "metric": "custom.proxmox.cluster.nodes.total",
          "dimensionKey": "cluster_name"
        }
      }
    },
    {
      "key": "node_name",
      "displayName": "Node",
      "type": "QUERY",
      "definition": {
        "seriesResolution": "AUTO",
        "queryDefinition": {
          "type": "METRIC",
          "metric": "custom.proxmox.node.cpu.usage",
          "dimensionKey": "node_name"
        }
      }
    }
  ],
  "tiles": {
    "0": {
      "type": "markdown",
      "title": "",
      "content": "# 🖥️ Proxmox VE — Cluster Overview\n**Cluster:** $cluster_name"
    },
    "1": {
      "type": "data",
      "title": "Nodes Online",
      "queryConfig": {
        "metricSelector": "custom.proxmox.cluster.nodes.online:filter(eq(cluster_name,$cluster_name)):last",
        "visualization": {
          "type": "singleValue",
          "singleValueConfig": {
            "showTrend": false,
            "showSparkLine": false
          }
        }
      }
    },
    "2": {
      "type": "data",
      "title": "Nodes Total",
      "queryConfig": {
        "metricSelector": "custom.proxmox.cluster.nodes.total:filter(eq(cluster_name,$cluster_name)):last",
        "visualization": {
          "type": "singleValue",
          "singleValueConfig": {
            "showTrend": false,
            "showSparkLine": false
          }
        }
      }
    },
    "3": {
      "type": "markdown",
      "title": "",
      "content": "---\n## 🗄️ Nodes"
    },
    "4": {
      "type": "data",
      "title": "Node CPU Usage (%)",
      "queryConfig": {
        "metricSelector": "custom.proxmox.node.cpu.usage:filter(eq(cluster_name,$cluster_name)):splitBy(node_name):avg",
        "visualization": {
          "type": "lineChart"
        }
      }
    },
    "5": {
      "type": "data",
      "title": "Node Memory Used",
      "queryConfig": {
        "metricSelector": "custom.proxmox.node.memory.used:filter(eq(cluster_name,$cluster_name)):splitBy(node_name):avg",
        "visualization": {
          "type": "lineChart"
        }
      }
    },
    "6": {
      "type": "data",
      "title": "Node Memory Total",
      "queryConfig": {
        "metricSelector": "custom.proxmox.node.memory.total:filter(eq(cluster_name,$cluster_name)):splitBy(node_name):last",
        "visualization": {
          "type": "barChart"
        }
      }
    },
    "7": {
      "type": "data",
      "title": "Node Disk Used",
      "queryConfig": {
        "metricSelector": "custom.proxmox.node.disk.used:filter(eq(cluster_name,$cluster_name)):splitBy(node_name):last",
        "visualization": {
          "type": "barChart"
        }
      }
    },
    "8": {
      "type": "data",
      "title": "Node Disk Total",
      "queryConfig": {
        "metricSelector": "custom.proxmox.node.disk.total:filter(eq(cluster_name,$cluster_name)):splitBy(node_name):last",
        "visualization": {
          "type": "barChart"
        }
      }
    },
    "9": {
      "type": "data",
      "title": "Node Network In",
      "queryConfig": {
        "metricSelector": "custom.proxmox.node.network.in:filter(eq(cluster_name,$cluster_name)):splitBy(node_name):avg",
        "visualization": {
          "type": "lineChart"
        }
      }
    },
    "10": {
      "type": "data",
      "title": "Node Network Out",
      "queryConfig": {
        "metricSelector": "custom.proxmox.node.network.out:filter(eq(cluster_name,$cluster_name)):splitBy(node_name):avg",
        "visualization": {
          "type": "lineChart"
        }
      }
    },
    "11": {
      "type": "data",
      "title": "Node Uptime",
      "queryConfig": {
        "metricSelector": "custom.proxmox.node.uptime:filter(eq(cluster_name,$cluster_name)):splitBy(node_name):last",
        "visualization": {
          "type": "barChart"
        }
      }
    },
    "12": {
      "type": "markdown",
      "title": "",
      "content": "---\n## 💻 Virtual Machines"
    },
    "13": {

    "29": {
      "type": "markdown",
      "title": "",
      "content": "---\n## 💾 Storage"
    },
    "30": {
      "type": "data",
      "title": "Storage Used",
      "queryConfig": {
        "metricSelector": "custom.proxmox.storage.used:filter(eq(cluster_name,$cluster_name)):splitBy(storage_name,node_name):last",
        "visualization": {
          "type": "barChart"
        }
      }
    },
    "31": {
      "type": "data",
      "title": "Storage Total",
      "queryConfig": {
        "metricSelector": "custom.proxmox.storage.total:filter(eq(cluster_name,$cluster_name)):splitBy(storage_name,node_name):last",
